# ─────────────────────────────────────────────────────────────
#  Sistem Asesmen Sumatif Akhir — MTs YTI Sukamerang
#  Salin nilai di bawah ke Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string
# Pilih "Connection pooling" / mode "Transaction" (port 6543), bukan koneksi langsung.
# Koneksi langsung (5432) hanya IPv6 dan tidak bisa dipakai dari Vercel.
DATABASE_URL=postgresql://postgres.xxxxxxxx:RAHASIA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase → Project Settings → API
# Service role key HANYA dipakai di server (jangan ditaruh di kode frontend).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nama bucket penyimpanan naskah PDF (dibuat otomatis saat unggah pertama)
SUPABASE_BUCKET=exam-files

# Kata sandi guru saat aplikasi pertama kali dijalankan.
# Setelah masuk, ganti lewat panel guru (ikon ⚙) — nilai ini tidak menimpa
# kata sandi yang sudah tersimpan di database.
EXAM_ADMIN_PASSWORD=MTsYTI2026
